<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="WoWSmartFishingPinTemplate" mixin="WoWSmartFishingPinMixin" virtual="true" enableMouse="true">
        <Size x="20" y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Ring" setAllPoints="true">
                    <Color r="0.07" g="0.08" b="0.10" a="0.95"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\Icons\Trade_Fishing">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
